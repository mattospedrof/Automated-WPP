# ─── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
installer/output/
*.spec
*.spec.backup
*.manifest

# ─── Virtual Environment ──────────────────────────────
.venv/
venv/
env/

# ─── IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Selenium / Chrome ────────────────────────────────
chromedriver
chromedriver.exe
*.chromedriver

# ─── WhatsApp Session (tokens de autenticação) ────────
wa_session/
# Mantém a pasta no repo mas ignora o conteúdo
!wa_session/.gitkeep

# ─── Planilhas e dados de clientes ────────────────────
# IMPORTANTE: nunca subir dados reais de contatos
*.xlsx
*.csv
*.xlsx~
*.csv~
# Exceção: arquivo de exemplo com dados fictícios
!exemplo_contatos.xlsx

# ─── Logs ─────────────────────────────────────────────
*.log
logs/
tmp/
tmp/logs/

# ─── Sessões e dados temporários ──────────────────────
.qwen

# ─── PyInstaller ──────────────────────────────────────
# Gerado pelo build — não deve ir pro repo
*.spec.backup

# ─── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Arquivos de teste / scripts internos ─────────────
lista_teste.xlsx
app_test_fixed.py
build.bat
release.bat

# ─── Media gerada ─────────────────────────────────────
media/color_data.png

